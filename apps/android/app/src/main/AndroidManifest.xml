<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16: el turno en curso como Live Update (la Live Activity de iOS). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Guardar el QR en la galería en Android 8 y 9 (desde el 10 no hace falta). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Custom Tabs para el ingreso con Clerk (Google y Apple). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <package android:name="com.instagram.android" />
        <package android:name="com.whatsapp" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/red"
        android:supportsRtl="false"
        android:theme="@style/Tema.TengoLibre">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ar.com.tengolibre.app.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/archivos" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- La vuelta de Clerk (Google y Apple), como en iOS. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ar.com.tengolibre.app" android:host="callback" />
            </intent-filter>
            <!-- tengolibre:// (widgets, avisos). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tengolibre" />
            </intent-filter>
            <!-- App Links de tengolibre.com.ar (Universal Links en iOS): falta assetlinks.json en la web. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="tengolibre.com.ar" />
                <data android:pathPrefix="/turno/" />
                <data android:pathPrefix="/invitacion/" />
                <data android:pathPrefix="/panel/turnos/" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Firebase se inicia a mano (push/Push.kt): sin config no hay push. -->
        <service android:name=".push.ServicioPush" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Las acciones de los avisos que no abren la app (Confirmar, Avisar a la lista, Responder, Atendido). -->
        <receiver android:name=".push.AccionesPush" android:exported="false" />

        <!-- «Tu día» (TengoLibreWidgets en iOS). -->
        <receiver android:name=".widgets.WidgetDiaReceiver" android:exported="true" android:label="Tu día">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_dia" />
        </receiver>
    </application>
</manifest>
