<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Manifiesto de privacidad de la app. Sin rastreo ni dominios de rastreo. Lo que se manda a la API de Tengo Libre
     (sólo para que la app funcione): nombre y mail de la cuenta (Clerk) y de las clientas, teléfonos que carga el
     negocio, fotos (logo, portada, equipo y servicios), la compra de la suscripción, notas y textos, el id de la cuenta
     y el token de los avisos. APIs de razón requerida: UserDefaults (CA92.1, sólo la app; no hay App Group) y la
     fecha de los archivos guardados para ver sin conexión (C617.1, Nucleo/Api.swift › Guardado). -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
