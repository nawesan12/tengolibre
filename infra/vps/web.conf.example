# /opt/tengolibre/web.conf (chmod 600). El front de TengoLibre.
NODE_ENV=production
HOST=0.0.0.0
PORT=3400
# Detrás de Caddy: el origen real (tengolibre.com.ar o un dominio propio) sale de estos encabezados.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
BODY_SIZE_LIMIT=12M
TENGOLIBRE_API=http://api:4200
PUBLIC_CLERK_PUBLICABLE=pk_live_...
